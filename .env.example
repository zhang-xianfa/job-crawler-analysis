# BOSS直聘爬虫配置文件
# 使用方法：
# 1. 将此文件复制为 .env
# 2. 配置以下变量
# 3. 在浏览器登录BOSS直聘后获取Cookie并填入

# =============================================================================
#  必填配置项
# =============================================================================

# 从浏览器复制的完整Cookie（包括zp_token、__zp_stoken__等字段）
# 获取方法：登录BOSS直聘 -> F12打开控制台 -> 网络 -> 复制请求头中的Cookie
BOSS_COOKIE=在这里替换成你的完整Cookie

# =============================================================================
#  城市与搜索关键词配置（支持单值/多值）
# =============================================================================

# 城市配置（支持中文名或城市编码，多值用逗号分隔）
# 可直接使用城市中文名，程序会自动映射编码：
#   北京, 上海, 广州, 深圳, 杭州, 南京, 成都, 武汉, 西安, 重庆,
#   苏州, 天津, 长沙, 宁波, 青岛, 济南, 厦门, 福州, 合肥, 郑州, 昆明
# 单值配置示例（旧写法仍兼容）:
# CITY_CODE=青岛
# CITY_CODE=101120200
# 多值配置示例:
# CITY_CODE=北京,上海,杭州
CITY_CODE=青岛

# 搜索关键词配置（多值用逗号分隔，会分别爬取每个关键词）
# 单值配置示例（旧写法仍兼容）:
# SEARCH_QUERY=数据分析师
# 多值配置示例（累积爬取更多数据）:
# SEARCH_QUERY=数据分析师,数据运营,商业分析,BI工程师
SEARCH_QUERY=数据分析师

# =============================================================================
#  可选配置项（有默认值，一般无需修改）
# =============================================================================

# User-Agent（默认使用Edge浏览器）
USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/134.0.0.0 Safari/537.36 Edg/134.0.0.0

# 起始页码
PAGE=1

# 请求超时时间（秒）
REQUEST_TIMEOUT=30

# 重试次数
RETRY_TIMES=3

# 重试间隔（秒）
RETRY_DELAY=2

# =============================================================================
#  MySQL数据库配置
# =============================================================================

MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_password
MYSQL_DB=recruitment_db
